.class public final Lzz/AdBlockObserver;
.super __BASE_OBSERVER__
.source "AdBlockObserver.java"

# PATCH adblock-inject
# Hand-written WebContentsObserver (__BASE_OBSERVER__ is the obfuscated Chromium WebContentsObserver, the parent of
# dev.cobalt.shell.StartupGuardNavigationObserver). Injects patches/adblock.js into every
# primary main frame document via the native WebContentsImpl.evaluateJavaScript, whose Java
# wrapper R8 stripped but whose JNI stub GEN_JNI still exposes.
# Generated by lib/steps/patch.sh, which fills in the __PLACEHOLDERS__ (obfuscated names + script).

.field private final webContents:Lcobalt/org/chromium/content_public/browser/WebContents;


.method public constructor <init>(Lcobalt/org/chromium/content_public/browser/WebContents;)V
    .locals 0

    invoke-direct {p0}, __BASE_OBSERVER__-><init>()V
    iput-object p1, p0, Lzz/AdBlockObserver;->webContents:Lcobalt/org/chromium/content_public/browser/WebContents;
    invoke-virtual {p0, p1}, __BASE_OBSERVER__->observe(Lcobalt/org/chromium/content_public/browser/WebContents;)V
    return-void
.end method


.method private inject(Ljava/lang/String;)V
    .locals 5

    :try_start
    iget-object v0, p0, Lzz/AdBlockObserver;->webContents:Lcobalt/org/chromium/content_public/browser/WebContents;
    instance-of v1, v0, Lcobalt/org/chromium/content/browser/webcontents/WebContentsImpl;
    if-eqz v1, :done

    check-cast v0, Lcobalt/org/chromium/content/browser/webcontents/WebContentsImpl;
    iget-wide v1, v0, Lcobalt/org/chromium/content/browser/webcontents/WebContentsImpl;->__NATIVE_PTR__:J
    const-wide/16 v3, 0x0
    cmp-long v3, v1, v3
    if-eqz v3, :done

    const-string v3, "atv-adblock"
    invoke-static {v3, p1}, Landroid/util/Log;->i(Ljava/lang/String;Ljava/lang/String;)I

    const-string v3, "__SCRIPT__"
    const/4 v4, 0x0
    invoke-static {v1, v2, v3, v4}, Lorg/jni_zero/GEN_JNI;->cobalt_org_chromium_content_browser_webcontents_WebContentsImpl_evaluateJavaScript(JLjava/lang/Object;Ljava/lang/Object;)V
    :try_end
    .catch Ljava/lang/Throwable; {:try_start .. :try_end} :failed

    :done
    return-void

    :failed
    move-exception v0
    const-string v1, "atv-adblock"
    const-string v2, "inject failed"
    invoke-static {v1, v2, v0}, Landroid/util/Log;->w(Ljava/lang/String;Ljava/lang/String;Ljava/lang/Throwable;)I
    return-void
.end method


