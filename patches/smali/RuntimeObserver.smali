.class public final Lzz/RuntimeObserver;
.super __BASE_OBSERVER__
.source "RuntimeObserver.java"

# PATCH runtime-inject
# Hand-written WebContentsObserver (__BASE_OBSERVER__ is the obfuscated Chromium WebContentsObserver,
# the parent of dev.cobalt.shell.StartupGuardNavigationObserver). Injects patches/runtime.js into
# every primary main frame document via the native WebContentsImpl.evaluateJavaScript, whose Java
# wrapper R8 stripped but whose JNI stub GEN_JNI still exposes.
# Generated by lib/steps/patch.sh, which fills in the __PLACEHOLDERS__ (obfuscated names, script,
# and __DEVTOOLS_INIT__: EvalReceiver registration in --devtools builds, empty otherwise).

.field private final webContents:Lcobalt/org/chromium/content_public/browser/WebContents;


.method public constructor <init>(Lcobalt/org/chromium/content_public/browser/WebContents;)V
    .locals 0

    invoke-direct {p0}, __BASE_OBSERVER__-><init>()V
    iput-object p1, p0, Lzz/RuntimeObserver;->webContents:Lcobalt/org/chromium/content_public/browser/WebContents;
    invoke-virtual {p0, p1}, __BASE_OBSERVER__->observe(Lcobalt/org/chromium/content_public/browser/WebContents;)V
__DEVTOOLS_INIT__
    return-void
.end method


# Run a script in the current primary main frame. Must be called on the UI thread.
.method public final evaluate(Ljava/lang/String;)V
    .locals 5

    :try_start
    iget-object v0, p0, Lzz/RuntimeObserver;->webContents:Lcobalt/org/chromium/content_public/browser/WebContents;
    instance-of v1, v0, Lcobalt/org/chromium/content/browser/webcontents/WebContentsImpl;
    if-eqz v1, :done

    check-cast v0, Lcobalt/org/chromium/content/browser/webcontents/WebContentsImpl;
    iget-wide v1, v0, Lcobalt/org/chromium/content/browser/webcontents/WebContentsImpl;->__NATIVE_PTR__:J
    const-wide/16 v3, 0x0
    cmp-long v3, v1, v3
    if-eqz v3, :done

    const/4 v4, 0x0
    invoke-static {v1, v2, p1, v4}, Lorg/jni_zero/GEN_JNI;->cobalt_org_chromium_content_browser_webcontents_WebContentsImpl_evaluateJavaScript(JLjava/lang/Object;Ljava/lang/Object;)V
    :try_end
    .catch Ljava/lang/Throwable; {:try_start .. :try_end} :failed

    :done
    return-void

    :failed
    move-exception v0
    const-string v1, "utv-runtime"
    const-string v2, "evaluate failed"
    invoke-static {v1, v2, v0}, Landroid/util/Log;->w(Ljava/lang/String;Ljava/lang/String;Ljava/lang/Throwable;)I
    return-void
.end method


.method private inject(Ljava/lang/String;)V
    .locals 1

    const-string v0, "utv-runtime"
    invoke-static {v0, p1}, Landroid/util/Log;->i(Ljava/lang/String;Ljava/lang/String;)I
    const-string v0, "__SCRIPT__"
    invoke-virtual {p0, v0}, Lzz/RuntimeObserver;->evaluate(Ljava/lang/String;)V
    return-void
.end method


.method public final primaryMainDocumentElementAvailable()V
    .locals 1

    const-string v0, "inject: primaryMainDocumentElementAvailable"
    invoke-direct {p0, v0}, Lzz/RuntimeObserver;->inject(Ljava/lang/String;)V
    return-void
.end method


.method public final didFinishNavigationInPrimaryMainFrame(Lcobalt/org/chromium/content_public/browser/NavigationHandle;)V
    .locals 1

    const-string v0, "inject: didFinishNavigationInPrimaryMainFrame"
    invoke-direct {p0, v0}, Lzz/RuntimeObserver;->inject(Ljava/lang/String;)V
    return-void
.end method


# Log channel from the page: runtime.js report() briefly sets document.title to "utv:<message>".
# Cobalt drops console output from injected code and YouTube swallows uncaught errors, so the title
# is the reliable way out. Logged under the tag utv-runtime.
.method public final titleWasSet(Ljava/lang/String;)V
    .locals 1

    if-eqz p1, :done
    const-string v0, "utv:"
    invoke-virtual {p1, v0}, Ljava/lang/String;->startsWith(Ljava/lang/String;)Z
    move-result v0
    if-eqz v0, :done

    const-string v0, "utv-runtime"
    invoke-static {v0, p1}, Landroid/util/Log;->i(Ljava/lang/String;Ljava/lang/String;)I

    :done
    return-void
.end method
